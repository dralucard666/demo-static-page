<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✨</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}" />
</head>
<body>
  <div class="bg-decor" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
  </div>

  <header class="site-header">
    <nav>
      <a href="{{ '/' | url }}" class="brand">My Website</a>
      <div class="nav-links">
        <a href="{{ '/' | url }}">Home</a>
        <a href="{{ '/about/' | url }}">About</a>
      </div>
    </nav>
  </header>

  <main>
    <div class="card">
      {% for section in sections %}
        {% if section.type == "hero" %}
          <div class="block block-hero">
            <h1>{{ section.heading }}</h1>
            {% if section.subtitle %}<p class="subtitle">{{ section.subtitle }}</p>{% endif %}
          </div>
        {% elif section.type == "text" %}
          <div class="block block-text prose">{{ section.body | safe }}</div>
        {% elif section.type == "image" %}
          <figure class="block block-image">
            <img src="{{ section.src }}" alt="{{ section.alt }}" />
            {% if section.caption %}<figcaption>{{ section.caption }}</figcaption>{% endif %}
          </figure>
        {% elif section.type == "quote" %}
          <blockquote class="block block-quote">
            <p>{{ section.text }}</p>
            {% if section.author %}<cite>{{ section.author }}</cite>{% endif %}
          </blockquote>
        {% elif section.type == "button" %}
          <div class="block block-button">
            <a class="btn" href="{{ section.url }}">{{ section.label }}</a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </main>

  <footer class="site-footer">
    <p>&copy; {% year %} My Website</p>
  </footer>
</body>
</html>
